VITE_API_BASE_URL=http://localhost:8080/api/v1
# Map tiles (optional; defaults to OpenFreeMap Positron, no key needed)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Public Mapbox token (pk.…): place search, reverse lookups, road routing
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
VITE_INACTIVITY_TIMEOUT=5
VITE_NODE_ENVIRONMENT=development
VITE_PAYMENT_MODE=simulate
