NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=peekaboo
DB_USER=
DB_PASSWORD=
JWT_SECRET=peekaboo

# Optional: Seed an admin user for local testing
SEED_ADMIN_EMAIL=info@peekaboo.co.rw
SEED_ADMIN_PHONE=0780000000
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin
SEED_ADMIN_RESET_PASSWORD=false

# WhatsApp
# Your WhatsApp Business access token
WHATSAPP_BUSINESS_ACCESS_TOKEN=
# Your WhatsApp Business phone number ID
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# WhatsApp Business API version
WHATSAPP_BUSINESS_API_VERSION=v20.0
# WhatsApp test phone number (E.164 format, e.g. +15556036149)
WHATSAPP_TEST_PHONE_NUMBER=
# WhatsApp Business account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WhatsApp Business webhook verify token
WHATSAPP_BUSINESS_VERIFY_TOKEN=
# WhatsApp Business API URL
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com


# Kpay Configuration
# Authentication: Basic Authorization (username:password)
KPAY_USERNAME=your_kpay_username_here
KPAY_PASSWORD=your_kpay_password_here

# Base URL: Use pay.esicia.rw for production, pay.esicia.com for sandbox
KPAY_BASE_URL=https://pay.esicia.com

# Retailer ID provided by Kpay
KPAY_RETAILER_ID=your_retailer_id_here

# Webhook URL for payment notifications
KPAY_WEBHOOK_URL=https://your-domain.com/api/payments/webhook/kpay

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Frontend URLs for OAuth redirects
FRONTEND_URL=http://localhost:5173
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
FRONTEND_AUTH_FAILURE_URL=http://localhost:5173/auth/login

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here
RESEND_EMAIL=noreply@peekaboo.co.rw
ADMIN_NOTIFICATION_EMAIL=info@peekaboo.co.rw

# Pindo SMS Service
PINDO_API_URL=https://api.pindo.io/v1/sms/
PINDO_TOKEN=your_pindo_api_token_here
PINDO_SENDER_ID=Peekaboo

# Frontend URL (used for email links)
CLIENT_URL=http://localhost:5173

# Google Maps API (used for distance calculations in rider assignment)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Push Notifications (OneSignal)
# Use the REST API Key from Settings → Keys & IDs for the SAME app as ONESIGNAL_APP_ID.
# Mobile EXPO_PUBLIC_ONESIGNAL_APP_ID must match ONESIGNAL_APP_ID. Trim values; no quotes.
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
# Android: channel UUIDs from OneSignal Dashboard → Settings → Message → Android Channels.
# Omit or leave empty to skip android_channel_id (default channel). Map logical keys from code:
#   assignments → ONESIGNAL_ANDROID_CHANNEL_ASSIGNMENTS
#   assignments_urgent → ONESIGNAL_ANDROID_CHANNEL_ASSIGNMENTS_URGENT
# ONESIGNAL_ANDROID_CHANNEL_ASSIGNMENTS=
# ONESIGNAL_ANDROID_CHANNEL_ASSIGNMENTS_URGENT=
# Dashboard checklist (manual): same OneSignal app has FCM (Android) + APNs (iOS) configured;
# after rider logs in on a device build, Audience → Subscriptions should show External ID = user UUID.
# Set to true to skip all OneSignal API calls locally (assignment flows still work).
# PUSH_NOTIFICATIONS_DISABLED=true
# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=peekaboo/avatars
CLOUDINARY_STATUS_PROOF_FOLDER=peekaboo/status-proofs
CLOUDINARY_PROBLEM_REPORT_FOLDER=peekaboo/problem-reports

# Problem report video watermark (upload your Peekaboo logo to Cloudinary and set its public id)
# Example: peekaboo/watermarks/peekaboo-black-yellow
CLOUDINARY_PROBLEM_REPORT_WATERMARK_PUBLIC_ID=

# Optional automatic logo upload for watermarking (used if public id above is empty)
PROBLEM_REPORT_WATERMARK_LOCAL_PATH=src/assets/watermarks/peekaboo-black-yellow.jpeg
CLOUDINARY_WATERMARK_FOLDER=peekaboo/watermarks
CLOUDINARY_PROBLEM_REPORT_WATERMARK_NAME=peekaboo-black-yellow
