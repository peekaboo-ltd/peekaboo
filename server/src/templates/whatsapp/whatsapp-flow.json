{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "RECIPIENT": ["PICKUP_METHOD"],
    "PICKUP_METHOD": ["PICKUP_SEARCH", "LOCATION_REQUEST_NOTICE"],
    "PICKUP_SEARCH": ["PICKUP_RESULTS"],
    "PICKUP_RESULTS": ["DROPOFF"],
    "DROPOFF": ["SUCCESS"],
    "LOCATION_REQUEST_NOTICE": [],
    "SUCCESS": []
  },
  "screens": [
    {
      "id": "RECIPIENT",
      "title": "Recipient Details",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "recipient_form",
            "children": [
              {
                "type": "TextInput",
                "label": "Recipient's Phone Number",
                "name": "recipient_phone",
                "input-type": "phone",
                "required": true,
                "helper-text": "Enter the recipient's Rwandan phone number"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "PICKUP_METHOD"
                  },
                  "payload": {
                    "recipient_phone": "${form.recipient_phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_METHOD",
      "title": "Pickup Location",
      "data": {
        "recipient_phone": {
          "type": "string",
          "__example__": "0780000000"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_method_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "label": "How would you like to provide the pickup location?",
                "name": "pickup_method",
                "required": true,
                "data-source": [
                  {
                    "id": "type_address",
                    "title": "Search/type pickup address"
                  },
                  {
                    "id": "current_location",
                    "title": "Use my current location"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "recipient_phone": "${data.recipient_phone}",
                    "pickup_method": "${form.pickup_method}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_SEARCH",
      "title": "Search Pickup",
      "data": {
        "recipient_phone": {
          "type": "string",
          "__example__": "0780000000"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_search_form",
            "children": [
              {
                "type": "TextInput",
                "label": "Pickup Location",
                "name": "pickup_query",
                "input-type": "text",
                "required": true,
                "helper-text": "Example: Kimironko Market, Kacyiru near RDB"
              },
              {
                "type": "Footer",
                "label": "Search",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "recipient_phone": "${data.recipient_phone}",
                    "pickup_query": "${form.pickup_query}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_RESULTS",
      "title": "Choose Pickup",
      "data": {
        "recipient_phone": {
          "type": "string",
          "__example__": "0780000000"
        },
        "pickup_search_session_id": {
          "type": "string",
          "__example__": "search_123"
        },
        "pickup_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "google:place_123",
              "title": "Kimironko Market",
              "description": "KG 11 Ave, Kigali, Rwanda"
            },
            {
              "id": "google:place_456",
              "title": "Kigali Convention Centre",
              "description": "KG 2 Roundabout, Kigali, Rwanda"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_results_form",
            "children": [
              {
                "type": "Dropdown",
                "label": "Select pickup location",
                "name": "pickup_place_id",
                "required": true,
                "data-source": "${data.pickup_options}"
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "DROPOFF"
                  },
                  "payload": {
                    "recipient_phone": "${data.recipient_phone}",
                    "pickup_search_session_id": "${data.pickup_search_session_id}",
                    "pickup_place_id": "${form.pickup_place_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DROPOFF",
      "title": "Drop-off Location",
      "data": {
        "recipient_phone": {
          "type": "string",
          "__example__": "0780000000"
        },
        "pickup_search_session_id": {
          "type": "string",
          "__example__": "search_123"
        },
        "pickup_place_id": {
          "type": "string",
          "__example__": "google:place_123"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "dropoff_form",
            "children": [
              {
                "type": "TextInput",
                "label": "Drop-off Address",
                "name": "dropoff_address",
                "input-type": "text",
                "required": true,
                "helper-text": "Where should the package be delivered?"
              },
              {
                "type": "Footer",
                "label": "Place Order",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "recipient_phone": "${data.recipient_phone}",
                    "pickup_search_session_id": "${data.pickup_search_session_id}",
                    "pickup_place_id": "${data.pickup_place_id}",
                    "dropoff_address": "${form.dropoff_address}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "LOCATION_REQUEST_NOTICE",
      "title": "Share Pickup Location",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Almost done"
          },
          {
            "type": "TextBody",
            "text": "We will ask you to share your pickup location in this WhatsApp chat. Tap Done, then use the Send location button."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "next_step": "request_pickup_location"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Order Created!",
      "terminal": true,
      "success": true,
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "ORD-1001"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Your order has been placed!"
          },
          {
            "type": "TextBody",
            "text": "Check your WhatsApp for a payment link. Complete payment to dispatch your rider."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "order_id": "${data.order_id}"
              }
            }
          }
        ]
      }
    }
  ]
}
