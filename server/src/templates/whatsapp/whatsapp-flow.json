{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "SENDER_RECIPIENT": ["PICKUP_METHOD"],
    "PICKUP_METHOD": ["PICKUP_SEARCH", "LOCATION_REQUEST_NOTICE"],
    "PICKUP_SEARCH": ["PICKUP_RESULTS"],
    "PICKUP_RESULTS": ["PAYER", "PICKUP_SEARCH"],
    "PAYER": ["SENDER_REVIEW"],
    "SENDER_REVIEW": ["INVITATION_SENT"],
    "RECIPIENT_DECISION": ["DROPOFF_METHOD", "DECLINED"],
    "DROPOFF_METHOD": ["DROPOFF_SEARCH", "LOCATION_REQUEST_NOTICE"],
    "DROPOFF_SEARCH": ["DROPOFF_RESULTS"],
    "DROPOFF_RESULTS": ["QUOTE", "WAITING_FOR_PAYER", "DROPOFF_SEARCH", "DROPOFF_METHOD"],
    "QUOTE": ["CARD_DETAILS", "PAYMENT_PENDING"],
    "CARD_DETAILS": ["PAYMENT_PENDING"],
    "LOCATION_REQUEST_NOTICE": [],
    "INVITATION_SENT": [],
    "WAITING_FOR_PAYER": [],
    "PAYMENT_PENDING": [],
    "DECLINED": []
  },
  "screens": [
    {
      "id": "SENDER_RECIPIENT",
      "title": "Recipient",
      "data": {
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "recipient_form",
            "children": [
              { "type": "TextBody", "text": "Enter the recipient's Rwandan WhatsApp mobile number." },
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "TextInput",
                "label": "Recipient mobile number",
                "name": "recipient_phone",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "recipient_phone": "${form.recipient_phone}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_METHOD",
      "title": "Pickup location",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "recipient_phone": { "type": "string", "__example__": "+250780000000" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_method_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "RadioButtonsGroup",
                "label": "How should we find the pickup?",
                "name": "location_method",
                "required": true,
                "data-source": [
                  { "id": "search", "title": "Search for a place" },
                  { "id": "gps", "title": "Share GPS location" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "location_method": "${form.location_method}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_SEARCH",
      "title": "Search pickup",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_search_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              { "type": "TextInput", "label": "Place or landmark", "name": "location_query", "required": true },
              {
                "type": "Footer",
                "label": "Search",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "location_query": "${form.location_query}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PICKUP_RESULTS",
      "title": "Choose pickup",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "search_session_id": { "type": "string", "__example__": "018e" },
        "location_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [{ "id": "google:abc", "title": "Kimironko Market", "description": "Kigali" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pickup_results_form",
            "children": [
              { "type": "Dropdown", "label": "Pickup", "name": "location_place_id", "required": true, "data-source": "${data.location_options}" },
              {
                "type": "Footer",
                "label": "Use this pickup",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "search_session_id": "${data.search_session_id}",
                    "location_place_id": "${form.location_place_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PAYER",
      "title": "Who will pay?",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "payer_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "RadioButtonsGroup",
                "label": "Select payer",
                "name": "payer_type",
                "required": true,
                "data-source": [
                  { "id": "SENDER", "title": "I will pay" },
                  { "id": "RECIPIENT", "title": "Recipient will pay" }
                ]
              },
              {
                "type": "Footer",
                "label": "Review",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "session_id": "${data.session_id}", "payer_type": "${form.payer_type}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SENDER_REVIEW",
      "title": "Review booking",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "recipient_phone": { "type": "string", "__example__": "+250780000000" },
        "pickup_label": { "type": "string", "__example__": "Kimironko Market" },
        "payer_label": { "type": "string", "__example__": "Sender" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Recipient: ${data.recipient_phone}\nPickup: ${data.pickup_label}\nPayer: ${data.payer_label}" },
          { "type": "TextCaption", "text": "${data.error}" },
          {
            "type": "Footer",
            "label": "Create draft & invite",
            "on-click-action": { "name": "data_exchange", "payload": { "session_id": "${data.session_id}" } }
          }
        ]
      }
    },
    {
      "id": "RECIPIENT_DECISION",
      "title": "Delivery invitation",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "decision_form",
            "children": [
              { "type": "TextBody", "text": "The sender asked you to provide the drop-off and receive major updates for this delivery." },
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "RadioButtonsGroup",
                "label": "Your choice",
                "name": "decision",
                "required": true,
                "data-source": [
                  { "id": "accept", "title": "Accept" },
                  { "id": "decline", "title": "Decline" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "session_id": "${data.session_id}", "decision": "${form.decision}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DROPOFF_METHOD",
      "title": "Drop-off location",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "dropoff_method_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "RadioButtonsGroup",
                "label": "How should we find the drop-off?",
                "name": "location_method",
                "required": true,
                "data-source": [
                  { "id": "search", "title": "Search for a place" },
                  { "id": "gps", "title": "Share GPS location" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "session_id": "${data.session_id}", "location_method": "${form.location_method}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DROPOFF_SEARCH",
      "title": "Search drop-off",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "dropoff_search_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              { "type": "TextInput", "label": "Place or landmark", "name": "location_query", "required": true },
              {
                "type": "Footer",
                "label": "Search",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "session_id": "${data.session_id}", "location_query": "${form.location_query}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DROPOFF_RESULTS",
      "title": "Choose drop-off",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "search_session_id": { "type": "string", "__example__": "018e" },
        "location_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [{ "id": "google:def", "title": "Kigali Heights", "description": "Kigali" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "dropoff_results_form",
            "children": [
              { "type": "Dropdown", "label": "Drop-off", "name": "location_place_id", "required": true, "data-source": "${data.location_options}" },
              {
                "type": "Footer",
                "label": "Use this drop-off",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "search_session_id": "${data.search_session_id}",
                    "location_place_id": "${form.location_place_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "QUOTE",
      "title": "Delivery quote",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "pickup_label": { "type": "string", "__example__": "Kimironko" },
        "dropoff_label": { "type": "string", "__example__": "Kigali Heights" },
        "distance_label": { "type": "string", "__example__": "8.2 km" },
        "duration_label": { "type": "string", "__example__": "22 min" },
        "amount_label": { "type": "string", "__example__": "1,000 RWF" },
        "payer_label": { "type": "string", "__example__": "Sender" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "quote_form",
            "children": [
              { "type": "TextBody", "text": "Pickup: ${data.pickup_label}\nDrop-off: ${data.dropoff_label}\nDistance: ${data.distance_label}\nEstimated duration: ${data.duration_label}\nFee: ${data.amount_label}\nPayer: ${data.payer_label}" },
              { "type": "TextCaption", "text": "${data.error}" },
              {
                "type": "RadioButtonsGroup",
                "label": "Fee approval",
                "name": "approve_quote",
                "required": true,
                "data-source": [{ "id": "true", "title": "I approve this fee" }]
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Payment method",
                "name": "payment_method",
                "required": true,
                "data-source": [
                  { "id": "MOMO", "title": "MTN MoMo" },
                  { "id": "AIRTEL_MONEY", "title": "Airtel Money" },
                  { "id": "CARD", "title": "Card" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue to payment",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "approve_quote": "${form.approve_quote}",
                    "payment_method": "${form.payment_method}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CARD_DETAILS",
      "title": "Card checkout",
      "data": {
        "session_id": { "type": "string", "__example__": "018f" },
        "error": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "card_form",
            "children": [
              { "type": "TextCaption", "text": "${data.error}" },
              { "type": "TextInput", "label": "Cardholder name", "name": "cardholder_name", "required": true },
              { "type": "TextInput", "label": "Email", "name": "cardholder_email", "input-type": "email", "required": true },
              {
                "type": "Footer",
                "label": "Create secure checkout",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "cardholder_name": "${form.cardholder_name}",
                    "cardholder_email": "${form.cardholder_email}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "LOCATION_REQUEST_NOTICE",
      "title": "Share location",
      "terminal": true,
      "data": { "location_kind": { "type": "string", "__example__": "pickup" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Return to the chat" },
          { "type": "TextBody", "text": "Tap Done, then use the WhatsApp location request to share the ${data.location_kind} GPS pin." },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "complete", "payload": {} } }
        ]
      }
    },
    {
      "id": "INVITATION_SENT",
      "title": "Invitation sent",
      "terminal": true,
      "success": true,
      "data": { "order_reference": { "type": "string", "__example__": "P123456" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Draft ${data.order_reference} created" },
          { "type": "TextBody", "text": "The recipient has five hours to accept the SMS invitation and provide the drop-off." },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "complete", "payload": {} } }
        ]
      }
    },
    {
      "id": "WAITING_FOR_PAYER",
      "title": "Drop-off saved",
      "terminal": true,
      "success": true,
      "data": { "order_reference": { "type": "string", "__example__": "P123456" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Thank you" },
          { "type": "TextBody", "text": "The quote for ${data.order_reference} has been sent to the selected payer." },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "complete", "payload": {} } }
        ]
      }
    },
    {
      "id": "PAYMENT_PENDING",
      "title": "Payment started",
      "terminal": true,
      "success": true,
      "data": { "payment_method": { "type": "string", "__example__": "MOMO" } },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Complete payment" },
          { "type": "TextBody", "text": "Follow the payment instructions sent in this chat. Payment must complete before the quote expires." },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "complete", "payload": {} } }
        ]
      }
    },
    {
      "id": "DECLINED",
      "title": "Invitation declined",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Delivery cancelled" },
          { "type": "TextBody", "text": "The sender has been notified." },
          { "type": "Footer", "label": "Done", "on-click-action": { "name": "complete", "payload": {} } }
        ]
      }
    }
  ]
}
