# Local development (default)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here

# Production (uncomment to use)
# EXPO_PUBLIC_API_BASE_URL=https://server.peekaboo.co.rw/api/v1

# EAS Build: set EXPO_PUBLIC_ONESIGNAL_APP_ID per profile in eas.json or via
# `eas env:create` / project secrets so cloud builds embed the real App ID (must match server ONESIGNAL_APP_ID).
# Manual verification: OneSignal app has FCM + APNs; use a dev client on a physical device; after login,
# check Audience → Subscriptions for External ID matching the API user id.
